# === Slack (REQUIRED) — the bot depends on these ===
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_CHANNEL_ID=C0123456789

# === YC Directory + a16z Speedrun (OPTIONAL, no key needed) ===
# These two sources work out of the box via public endpoints.

# === X / Twitter (OPTIONAL — provide a token to enable early founder signal) ===
# Official X API v2 Bearer token (Basic tier ~$100/mo), OR wire a third-party
# keyword monitor (Syften/Xcanner/XFlux) to POST to a pluggable adapter.
TWITTER_BEARER_TOKEN=

# === LinkedIn (OPTIONAL — provide an adapter endpoint to enable) ===
# No free public API. Wire a pluggable adapter (e.g. Apify no-cookie public
# scraper) that accepts POST {"query":..., "freshness_minutes":N} and returns
# {"results":[{author,text,url,published_at}]}.
LINKEDIN_ACCESS_TOKEN=

# === Monitoring ===
CHECK_INTERVAL_HOURS=8
STATE_DB_PATH=./state.jsonl
LOG_LEVEL=INFO